  "title": "联邦无政府主义者协会",
  "fr": "ASSOCIATION FÉDÉRALE DES ANARCHISTES",
  "year": 1936,
  "date": "一九三六年一月",
  "organisation": "联邦无政府主义者协会",
  "factions": {
    "agrarian": {
      "name": "农业无政府主义者",
      "short": "农业派",
      "fr": "LES LIBERTAIRES AGRARIENS",
      "color": "#c54a53",
      "delegates": 130,
      "position": "以乡村协会和农业合作社为基础。主张由公社联合购置农机、整合耕作与灌溉，保留村社对土地使用和收购办法的决定权。",
      "after": "愿与温和工团派协商运输、农机和合作社信贷；反对由全国机关直接规定村社的生产与分配。",
      "organisation": "村社讨论会、农业合作社、巡回讲习与共用农机组。",
      "press": "合作社经验、农业技术、地方预算；以具体改革争取农民。"
    },
    "syndicalist": {
      "name": "无政府工团主义者",
      "short": "无政府工团派",
      "fr": "LES ANARCHO-SYNDICALISTES",
      "color": "#df8992",
      "delegates": 50,
      "position": "保留下来的骨干多为车间代表、印刷工人、港口互助组和工人教育组织。主张工会受会员大会监督，工会职务与公社公职分别选举。",
      "after": "诉CGT案后，一部分温和骨干回到工团建制派，另一部分退出协会。留任者仍参加CGT基层工会，但拒绝接受革命工团委员会的政治指挥；报社、读书会与独立工会成为补充阵地。",
      "organisation": "车间讨论组、工会反对派、劳工会馆、失业互助和工人图书室。",
      "press": "公开工会账目、限制兼任、保障支部自主；针对CGT上层，不要求工人退会。"
    },
    "makhnovist": {
      "name": "马赫诺派",
      "short": "马赫诺派",
      "fr": "LES MAKHNOVISTES",
      "color": "#9d6cb5",
      "delegates": 20,
      "position": "以乌克兰黑军流亡者为绝大多数，另有少量民兵支持者。注重公社武装的自治、民兵选举军官以及军事组织对参加者的责任。",
      "after": "马赫诺已返法。在巴黎、里昂与马赛保有流亡者小组和民兵联络，但没有主导任何地方协会。军事经验使他们获得发言资格，尚不足以形成全国性的基层组织。",
      "organisation": "流亡者互助圈、译文小组、民兵联络与军事讲习。",
      "press": "流亡者遭遇、革命防卫、反对军官特权；不把地方争论一概作为军事问题处理。"
    },
    "individual": {
      "name": "个人派",
      "short": "个人派",
      "fr": "LES ADHÉRENTS INDIVIDUELS",
      "color": "#b19d95",
      "delegates": 10,
      "position": "以个人身份加入的成员，包括个人主义者、施蒂纳思想的读者，以及未加入稳定地方团体的边缘流派。对于统一纲领与代表授权尤为谨慎。",
      "after": "有个人代表和读书圈，没有控制任何地方协会。共同活动常限于出版、教育、个人自由及反对行政强制。",
      "organisation": "个人入会、通信圈、独立小刊物和自由讨论会。",
      "press": "思想与出版自由、个人选择；在理论栏目保留异议。"
    }
  },
